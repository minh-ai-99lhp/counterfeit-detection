# ─────────────────────────────────────────────────────────────
# Copy file này thành `.env` rồi điền giá trị thật.
# `.env` đã nằm trong .gitignore — KHÔNG BAO GIỜ commit.
# ─────────────────────────────────────────────────────────────

# ── 1. Dùng cho FRONTEND (React) + deploy lên Vercel ────────
# Dashboard → Project Settings (⚙️) → API  →  "Project URL"
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Cùng trang trên →  "Project API keys" →  key tên `anon` / `public`
# (UI mới gọi là "Publishable key", dạng sb_publishable_...)
# Key này AN TOÀN khi lộ ra client — nó bị chặn bởi RLS.
VITE_SUPABASE_ANON_KEY=

# ── 2. Dùng cho PYTHON WORKER (crawler + detection) ─────────
# Cùng trang trên →  key tên `service_role`
# (UI mới gọi là "Secret key", dạng sb_secret_...)
# ⚠️ Key này BỎ QUA TOÀN BỘ RLS — chỉ để ở worker chạy local.
# ⚠️ TUYỆT ĐỐI không đưa vào frontend hay biến môi trường Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ── 3. Dùng cho MIGRATION (supabase CLI) ────────────────────
# Dashboard → Project Settings → Database → "Connection string"
# → chọn tab **Session pooler**, KHÔNG phải "Direct connection"
#   (direct chỉ có IPv6, WSL của bạn nhiều khả năng không ra được)
# → copy dạng URI, nhớ thay [YOUR-PASSWORD] bằng mật khẩu DB thật.
# Quên mật khẩu DB → Settings → Database → Reset database password.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── 4. Nguồn CSDL hàng thật (worker/genuine_import.py) ─────
# Domain nguồn công khai, không có dấu / ở cuối
GENUINE_SOURCE_URL=https://example.com
